{
  "name": "stp-os",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-Park Core Facility & B2B Innovation Ecosystem",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "start": "node src/index.js",
    "start:worker": "node src/worker.js",
    "db:up": "docker compose up -d postgres",
    "db:backup": "node scripts/postgres-backup.mjs backup",
    "db:restore": "node scripts/postgres-backup.mjs restore",
    "pilot:seed": "node scripts/seed-pilot.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@clickhouse/client": "^1.23.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "pg": "^8.16.3",
    "kafkajs": "^2.2.4"
  }
}
